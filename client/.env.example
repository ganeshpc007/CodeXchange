# Copy this file to .env and fill in the values for your environment.

# Base URL of the backend REST API (include the /api suffix)
VITE_API_BASE_URL=http://localhost:5000/api

# URL of the backend Socket.IO server
VITE_SOCKET_URL=http://localhost:5000

# Optional: pre-fills the "Get Guest User Credentials" button on the sign-in page.
# Leave unset to disable the guest login shortcut.
VITE_GUEST_EMAIL=
VITE_GUEST_PASSWORD=
